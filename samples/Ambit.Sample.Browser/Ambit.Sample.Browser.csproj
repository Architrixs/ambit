<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>BROWSER</DefineConstants>
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.15" />
    <PackageReference Include="Avalonia.Browser" Version="11.3.15" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ambit.Core\Ambit.Core.csproj" />
    <ProjectReference Include="..\..\src\Ambit.Avalonia\Ambit.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile all shared files from desktop sample except Program.cs entrypoint -->
    <Compile Include="..\Ambit.Sample\**\*.cs" Exclude="..\Ambit.Sample\Program.cs;..\Ambit.Sample\obj\**\*.cs;..\Ambit.Sample\bin\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\Ambit.Sample\Assets\**" Exclude="..\Ambit.Sample\Assets\ANPR.mp4" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Ambit.Sample\Assets\ANPR.mp4" Link="wwwroot\Assets\ANPR.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
