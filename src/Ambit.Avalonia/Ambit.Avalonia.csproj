<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Ambit.Avalonia</RootNamespace>
    <AssemblyName>Ambit.Avalonia</AssemblyName>
    <PackageId>Lib.Ambit.Avalonia</PackageId>
    <Description>Avalonia rendering and interaction layer for Ambit — Skia-direct overlay controls and editing.</Description>
    <Authors>Ambit Contributors</Authors>
    <Company>Ambit</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Architrixs/ambit</RepositoryUrl>
    <PackageProjectUrl>https://architrixs.github.io/ambit/</PackageProjectUrl>
    <PackageTags>avalonia;skia;annotation;region;overlay</PackageTags>
    <Version>1.0.5</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>1591;1573;CS1591;CS1573;CS0618;0618</WarningsNotAsErrors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ambit.Core\Ambit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.15" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.15" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\ambit_icon.png" Pack="true" PackagePath="\icon.png" />
  </ItemGroup>
</Project>
